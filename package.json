{
  "name": "@baeoom-dev/webeditor",
  "version": "0.1.0",
  "description": "보안(XSS 방지)과 웹접근성을 최우선으로 한 Vanilla JS WYSIWYG 에디터. 엑셀 표 서식 보존 지원.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baeoom-dev/webeditor.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/webeditor.esm.js",
  "module": "./dist/webeditor.esm.js",
  "types": "./dist/webeditor.d.ts",
  "style": "./dist/webeditor.css",
  "exports": {
    ".": {
      "types": "./dist/webeditor.d.ts",
      "import": "./dist/webeditor.esm.js",
      "default": "./dist/webeditor.esm.js"
    },
    "./css": "./dist/webeditor.css",
    "./fonts": "./dist/webeditor-fonts.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "python3 -m http.server 8791",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wysiwyg",
    "editor",
    "rich-text",
    "vanilla-js",
    "contenteditable",
    "sanitizer",
    "accessibility",
    "excel-paste"
  ],
  "author": "baeoom",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": ">=18"
  }
}
